# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep .env.example tracked, ignore all other env files)
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example

# databases (SQLite local dev files — never commit)
*.db
*.sqlite
*.sqlite3
/db/*.db
/db/*.sqlite

# vercel
.vercel

# logs
*.log
dev.log
dev.out.log
server.log

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
test
prompt

# user-uploaded files (Vercel Blob is used in production; local dev writes here)
/public/uploads/*
!/public/uploads/.gitkeep

# skills directory
/skills/

# downloaded assets
/download/
/upload/

# junk
*.zip
.fuse_hidden*
/toWEBP.zip
