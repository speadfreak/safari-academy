# ============================================================
# Safari Academy — Environment Variables
# ============================================================
# Copy this file to `.env` for local dev, and add the same keys
# in the Vercel project settings for production.
# NEVER commit your real .env file. Only this .env.example is tracked.

# ------------------------------------------------------------
# DATABASE (required)
# ------------------------------------------------------------
# PostgreSQL connection string. For local dev use Neon, Supabase, or a local Postgres.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ------------------------------------------------------------
# AUTH (required)
# ------------------------------------------------------------
# A long, random string used to sign JWT session tokens.
# Generate one with:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# ------------------------------------------------------------
# NODE ENV
# ------------------------------------------------------------
NODE_ENV="development"

# ------------------------------------------------------------
# FILE UPLOADS — Vercel Blob (required for production)
# ------------------------------------------------------------
# Create a Blob store in Vercel → Storage → Create → Blob.
# Copy the "Blob Read Write Token" here.
# If unset, uploads fall back to local disk at /public/uploads (local dev only).
BLOB_READ_WRITE_TOKEN=""

# ------------------------------------------------------------
# SMTP (optional — for email notifications on form submissions)
# ------------------------------------------------------------
# If unset, form submissions are still stored in the database and visible in the admin Inbox.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ------------------------------------------------------------
# SITE URL (optional — used for absolute URLs in emails / sitemap)
# ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
